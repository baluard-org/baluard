{
  "name": "baluard-extension-shared",
  "version": "0.1.4",
  "description": "Baluard browser extension (shared source, chrome + firefox targets)",
  "type": "module",
  "scripts": {
    "build:chrome": "cross-env TARGET=chrome vite build",
    "build:firefox": "cross-env TARGET=firefox vite build",
    "build": "npm run build:chrome && npm run build:firefox",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "solid-js": "^1.8.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "sharp": "^0.33.0",
    "vite": "5.4.21",
    "vite-plugin-solid": "^2.10.0",
    "vitest": "^1.6.0",
    "jsdom": "^24.0.0"
  },
  "allowScripts": {
    "sharp@0.33.5": true
  }
}
