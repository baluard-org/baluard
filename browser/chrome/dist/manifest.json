{
  "manifest_version": 3,
  "name": "Baluard",
  "version": "0.1.0",
  "description": "Bridge client for the Baluard password manager. Connects to your local Baluard app.",
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Baluard",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}