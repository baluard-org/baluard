<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Package visibility (API 30+): the browser-integration rows probe
         Chromium third-party autofill state via each browser's content
         provider; without <queries> the packages are invisible and the
         probes always fail. -->
    <queries>
        <package android:name="com.brave.browser" />
        <package android:name="com.brave.browser.beta" />
        <package android:name="com.brave.browser.nightly" />
        <package android:name="com.android.chrome" />
        <package android:name="com.chrome.beta" />
        <package android:name="com.vivaldi.browser" />
    </queries>

    <application
        android:name=".BaluardApplication"
        android:label="Baluard"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Baluard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 6: Baluard autofill service. android:process=":autofill"
             (M8) makes the separate-process promise REAL: the service runs
             outside the main process with strict memory limits; unlocks via
             unlock_with_kek (KEK from AndroidKeystore gated by
             BiometricPrompt), NEVER the master KDF. See
             BaluardAutofillService for the OOM-guard invariant and
             AutofillProcessIsolationTest for the source-level assertion. -->
        <service
            android:name=".autofill.BaluardAutofillService"
            android:process=":autofill"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <!-- Capabilities: inline suggestions + browser compat list
                 (plan 2b/S2/S3). -->
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service_configuration" />
        </service>

        <!-- Accessibility fill (Phase 6.5, plan-android-accessibility-tile):
             Bitwarden-current model. The service idles listening ONLY for
             window-state changes and acts exclusively after the user arms
             the quick-settings fill tile. Gated by the Baluard-side flag
             (AccessibilityFill, default OFF) on every event.
             isAccessibilityTool=false: it is an autofill fallback, not an
             accessibility aid. -->
        <service
            android:name=".autofill.BaluardAccessibilityService"
            android:process=":autofill"
            android:exported="true"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <!-- Quick-settings fill tile: the user-facing trigger of the a11y
             flow. Same :autofill process so it arms the in-process bridge. -->
        <service
            android:name=".autofill.BaluardA11yTileService"
            android:process=":autofill"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/a11y_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- NoDisplay trampoline: collapsing the quick-settings shade must
             produce a window-state change for the armed service to see. -->
        <activity
            android:name=".autofill.A11yTileTrampoline"
            android:process=":autofill"
            android:exported="false"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Trampoline hosting the BiometricPrompt ceremony (plan D6). Same
             :autofill process as the service so AutofillSession is shared;
             translucent theme (NOT NoDisplay, the prompt needs a window);
             not exported (launched only via our own PendingIntent). -->
        <activity
            android:name=".autofill.AutofillActivity"
            android:process=":autofill"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Baluard.Autofill" />
        <!-- noHistory intentionally ABSENT: the activity sets its result
             asynchronously (fingerprint + unlock + response build); a
             noHistory activity is destroyed on stop and the auth result
             would never reach the autofill session. It finishes itself. -->

        <!-- Passkey credential provider (G10, plan §4): main process by
             design — the Begin phase needs decrypted usernames from the same
             unlocked session the app holds (SharedVaultSession). The
             trampoline is exported=false so only our own PendingIntents can
             launch it (extraction protection). -->
        <service
            android:name=".passkeys.BaluardCredentialProviderService"
            android:enabled="true"
            android:exported="true"
            android:label="Baluard"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/provider" />
        </service>
        <!-- E2E-only Credential Manager client (plan §12 loopback affordance):
             drives the provider from the client side deterministically where
             Chrome would race Google Password Manager. Launched by the harness
             via adb (root); never reachable from any UI. -->
        <activity
            android:name=".passkeys.PasskeyClientActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <activity
            android:name=".passkeys.PasskeyTrampolineActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Baluard.Autofill" />

        <!-- Native lib: the Rust cdylib (libbaluard.so) is packaged per-ABI
             under jniLibs/<abi>/ by the host build (cargo-ndk or manual copy).
             System.loadLibrary("baluard") resolves it at runtime. -->
    </application>

</manifest>
