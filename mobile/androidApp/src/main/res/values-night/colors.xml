<?xml version="1.0" encoding="utf-8"?>
<!-- Dark mode splash window background (before Compose draws).
     Brand dark app background (#14292C), matching Theme.kt. -->
<resources>
    <color name="splash_bg">#14292C</color>
    <!-- Autofill dataset popup rows: the row draws its own dark surface,
         so its text is always the light variant (contrast guaranteed). -->
