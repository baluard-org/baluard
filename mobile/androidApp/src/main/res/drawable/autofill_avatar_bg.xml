<?xml version="1.0" encoding="utf-8"?>
<!-- Login avatar tile: 12dp corners, same teal gradient as the app's
     CipherAvatar. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="@color/autofill_avatar_start"
        android:endColor="@color/autofill_avatar_end" />
    <corners android:radius="12dp" />
</shape>
