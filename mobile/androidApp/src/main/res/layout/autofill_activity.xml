<?xml version="1.0" encoding="utf-8"?>
<!-- Trampoline + picker host (ADR 0090/D10). OPAQUE on purpose: the
     fallback picker lists every login and previously rendered as bare
     rows over a translucent window, reading as a ghost of the vault
     over the browser (0.2.1 bug report). Dataset mode shows the same
     branded screen behind the biometric prompt. Plain Views only, no
     Compose in this process (D9). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/autofill_screen"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/autofill_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="54dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/autofill_brand_logo"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="9dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/autofill_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Baluard"
                android:textSize="21sp"
                android:textColor="@color/autofill_text" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/autofill_picker_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose a login"
                android:textSize="15sp"
                android:textColor="@color/autofill_muted_text" />
        </LinearLayout>

        <EditText
            android:id="@+id/autofill_picker_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/autofill_search_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:maxLines="1"
            android:inputType="text|textNoSuggestions"
            android:importantForAutofill="no"
            android:imeOptions="actionDone"
            android:textSize="15sp"
            android:textColor="@color/autofill_text"
            android:textColorHint="@color/autofill_muted_text"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/autofill_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:paddingTop="24dp" />

        <TextView
            android:id="@+id/autofill_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="@android:color/white" />

        <ScrollView
            android:id="@+id/autofill_picker_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/autofill_picker_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
