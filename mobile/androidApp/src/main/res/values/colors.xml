<?xml version="1.0" encoding="utf-8"?>
<!-- Light mode splash window background (before Compose draws).
     Brand light: Clean White / Slate (#F4F6F6). -->
<resources>
    <color name="splash_bg">#F4F6F6</color>
    <!-- Autofill dataset popup rows (RemoteViews): resolved against the
         TARGET APP's uiMode, which can differ from the system setting, and
         the popup surface color is the system's, not ours - so the row
         draws its OWN background and text from the same variant,
         guaranteeing contrast (device-pass finding). -->
    <color name="autofill_row_bg">#FFFFFF</color>
    <color name="autofill_text_primary">#1C1B1F</color>
    <color name="autofill_text_secondary">#49454F</color>
    <!-- AutofillActivity picker screen (opaque, in OUR process): the
         brand dark background and the muted username color, so the
         all-logins list never renders see-through over the browser
         (0.2.1 ghost bug). -->
    <color name="autofill_screen">#091315</color>
    <color name="autofill_muted_text">#A2B7BA</color>
    <!-- Picker card look, mirrored from the app's CipherRowCard
         (surfaceContainer #0B1517, outline #1D3A3D, login avatar gradient
         #0D9488-#0F766E, search field #14292C, primary text #F3F4F6). -->
    <color name="autofill_text">#F3F4F6</color>
    <color name="autofill_card">#0B1517</color>
    <color name="autofill_card_border">#1D3A3D</color>
    <color name="autofill_avatar_start">#0D9488</color>
    <color name="autofill_avatar_end">#0F766E</color>
    <color name="autofill_search_bg">#14292C</color>
    <color name="autofill_lime">#B3E55C</color>
</resources>
