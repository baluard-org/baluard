{
  "manifest_version": 3,
  "name": "spike-e snow-wasm tether",
  "version": "1.0.0",
  "description": "Spike E: stock Noise IK (snow, WASM) initiator in a Firefox MV3 event page",
  "background": {
    "scripts": ["glue.js", "background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "spike-e@baluard.invalid",
      "strict_min_version": "128.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
