# Baluard local secrets for development and testing.
# Copy to `.env` and fill in your values; `.env` is gitignored.
# Loaded automatically by `baluard` and `baluard-daemon` on startup
# (via the `dotenvy` crate). Real env vars take precedence over the file.

# ── GitHub ────────────────────────────────────────────────────────────────
# Override the embedded GitHub OAuth App client_id. The embedded value is
# the project's registered app; set this only if you're testing against a
# different app (e.g. one you registered yourself for the test).
BALUARD_GITHUB_CLIENT_ID=

# Personal Access Token (PAT) for headless / scripted testing. The PAT
# path is supported as a fallback under "Advanced options" in the
# desktop UI. Classic PAT with `repo` scope.
BALUARD_GITHUB_TOKEN=

# ── GitLab ────────────────────────────────────────────────────────────────
# Override the embedded GitLab client_id. The embedded value is the
# placeholder `REPLACE_WITH_GITLAB_CLIENT_ID` until the project group
# registers the OAuth app — see docs/dev/git-provider-apps-and-tokens.md §4.
BALUARD_GITLAB_CLIENT_ID=

# Personal Access Token (PAT) for testing. The `api` scope is required
# for repository creation; `read_repository` / `write_repository` are
# insufficient for the sync flow.
BALUARD_GITLAB_TOKEN=

# ── Codeberg ──────────────────────────────────────────────────────────────
# Override the embedded Codeberg client_id. The embedded value is the
# placeholder `REPLACE_WITH_CODEBERG_CLIENT_ID` until the project user
# registers the PKCE public-client app — see docs §5.
BALUARD_CODEBERG_CLIENT_ID=

# Personal Access Token (PAT) for testing. **Scoped** PATs (e.g.
# `write:repository` + specific repo selection) are more secure than
# Codeberg's OAuth2 flow, which has no scope support and grants full
# account access. Generated at
# https://codeberg.org/user/settings/applications under the "Tokens" tab.
BALUARD_CODEBERG_TOKEN=
