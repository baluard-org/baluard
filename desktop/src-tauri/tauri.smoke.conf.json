{
  "bundle": {
    "createUpdaterArtifacts": false
  },
  "app": {
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "smoke",
          "description": "test-only capabilities for the e2e smoke build",
          "windows": [
            "main"
          ],
          "permissions": [
            "wdio-webdriver:default"
          ]
        }
      ]
    },
    "windows": [
      {
        "title": "Baluard",
        "width": 1200,
        "height": 700,
        "minWidth": 900,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "additionalBrowserArgs": "--remote-debugging-port=9222 --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ]
  }
}
