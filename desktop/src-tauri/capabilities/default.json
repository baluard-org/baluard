{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:allow-open-url",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "baluard-daemon",
          "sidecar": true
        }
      ]
    },
    "shell:allow-kill",
    "biometry:default"
  ]
}
