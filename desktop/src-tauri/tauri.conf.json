{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Baluard",
  "identifier": "app.baluard.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Baluard",
        "width": 1200,
        "height": 700,
        "minWidth": 900,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "dmg",
      "app",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/baluard-daemon",
      "binaries/baluard",
      "binaries/baluard-nmh"
    ],
    "macOS": {
      "entitlements": "baluard.entitlements"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0t64",
          "libayatana-appindicator3-1",
          "libgit2-1.9",
          "libssl3t64",
          "libssh2-1"
        ],
        "recommends": [
          "gnome-keyring",
          "libu2f-udev"
        ],
        "files": {
          "/usr/lib/mozilla/native-messaging-hosts/app.baluard.browser.json": "nmh-manifests/firefox.json",
          "/usr/lib/mozilla/native-messaging-hosts/xyz.actitud.baluard.json": "nmh-manifests/firefox-legacy.json",
          "/etc/opt/chrome/native-messaging-hosts/app.baluard.browser.json": "nmh-manifests/chrome.json",
          "/etc/opt/chrome/native-messaging-hosts/xyz.actitud.baluard.json": "nmh-manifests/chrome-legacy.json",
          "/etc/chromium/native-messaging-hosts/app.baluard.browser.json": "nmh-manifests/chromium.json",
          "/etc/chromium/native-messaging-hosts/xyz.actitud.baluard.json": "nmh-manifests/chromium-legacy.json",
          "/etc/opt/edge/native-messaging-hosts/app.baluard.browser.json": "nmh-manifests/edge.json",
          "/etc/opt/edge/native-messaging-hosts/xyz.actitud.baluard.json": "nmh-manifests/edge-legacy.json"
        }
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3",
          "libgit2",
          "openssl-libs",
          "libssh2"
        ],
        "recommends": [
          "gnome-keyring"
        ],
        "files": {
          "/usr/lib64/mozilla/native-messaging-hosts/app.baluard.browser.json": "nmh-manifests/firefox.json",
          "/usr/lib64/mozilla/native-messaging-hosts/xyz.actitud.baluard.json": "nmh-manifests/firefox-legacy.json",
          "/etc/opt/chrome/native-messaging-hosts/app.baluard.browser.json": "nmh-manifests/chrome.json",
          "/etc/opt/chrome/native-messaging-hosts/xyz.actitud.baluard.json": "nmh-manifests/chrome-legacy.json",
          "/etc/chromium/native-messaging-hosts/app.baluard.browser.json": "nmh-manifests/chromium.json",
          "/etc/chromium/native-messaging-hosts/xyz.actitud.baluard.json": "nmh-manifests/chromium-legacy.json",
          "/etc/opt/edge/native-messaging-hosts/app.baluard.browser.json": "nmh-manifests/edge.json",
          "/etc/opt/edge/native-messaging-hosts/xyz.actitud.baluard.json": "nmh-manifests/edge-legacy.json"
        }
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwNzA3OTA4MTFFNTQ1NDAKUldSQVJlVVJDSGx3NEdZN2ZOczE0YjFwMzl3dG5TaW9WbWNxQm1XUXc1SzJMRG82SGhXTFp6OEsK",
      "requireSignedVersion": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
