{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "IDtty",
  "version": "0.1.0",
  "identifier": "xyz.actitud.idtty",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IDtty",
        "width": 900,
        "height": 600,
        "minWidth": 700,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/idtty-daemon",
      "binaries/idtty"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
