{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Baluard",
  "version": "0.1.0",
  "identifier": "xyz.actitud.baluard",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Baluard",
        "width": 1200,
        "height": 700,
        "minWidth": 900,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/baluard-daemon",
      "binaries/baluard"
    ],
    "macOS": {
      "entitlements": "baluard.entitlements"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
