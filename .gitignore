# ── OS / System ──
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ── IDEs / Agent tools ──
.idea/
.vscode/
.pi/
*.iml
*.sublime-*
.gradle/
.kotlin/

# ── Rust ──
/target/
**/*.rs.bk
Cargo.lock

# ── Compiled binaries ──
*.exe
*.exe~
*.dll
*.so
*.dylib

# ── Kotlin Multiplatform / Gradle ──
/build/
**/build/
.gradle/
local.properties
.cxx/
*.apk
*.aab
*.ipa
*.framework

# ── SolidJS Tauri Desktop ──
/desktop/node_modules/
/desktop/dist/
/desktop/src-tauri/target/
/desktop/src-tauri/gen/

# ── Release staging ──
# Signed release artifacts (just release-sign) and the package-repo output
# (just repo-stage) stay out of git: they are rebuilt from a tag plus the
# release keys, never committed.
/dist/
/repo-out/

# ── Browser Extension ──
/extension/node_modules/
/extension/dist/
# NOTE: browser/<store>/dist IS committed. The dists are reviewable
# packaging artifacts (manifest permissions are security-relevant, see B8)
# and the extension CI job fails when a rebuild diverges from them (B11).
browser/shared/node_modules/
browser/shared/*.tgz

# ── top-level Node ──
node_modules/
.npm/

# ── Secrets / Local Configurations ──
.env
.env.*
!.env.example
*.pem
*.key
# Demo signing-key fixtures for `just seed-demo`: generated material, not secrets.
!scripts/demo-certs/*.pem
!scripts/demo-certs/*.asc
*.p12
*.pfx
*.jks
*.dmg
*.msi
*.AppImage
*.crx
*.xpi
docs/reviews/
.codegraph/
bin/
desktop/src-tauri/binaries/
# Generated by scripts/build-nmh-manifests.sh; the deb/rpm bundles read them.
# Regenerate (never commit): the chrome origin depends on BALUARD_CHROME_EXTENSION_ID.
desktop/src-tauri/nmh-manifests/
cache/
logs/

# Generated app icons (regenerate via `just app-icons`, not committed)
assets/app-icons/
mobile/keystore/

# Stable-name release staging output (uploaded to the GitHub release)
/release-upload/
